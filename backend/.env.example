# FocusTrack Backend Environment Configuration Example
# Скопируйте этот файл в .env и заполните реальными значениями

# ============================================================
# Environment
# ============================================================
# Options: development, production
ENVIRONMENT=development

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://focustrack_user:focustrack_password@localhost:5432/focustrack

# ============================================================
# Security
# ============================================================
# ВАЖНО: Сгенерируйте криптографически стойкий ключ!
# Команда: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ============================================================
# Frontend
# ============================================================
# URL фронтенда для OAuth редиректов
# Development:
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://focustrack.yourdomain.com

# ============================================================
# Email (SMTP)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# ============================================================
# Google OAuth 2.0
# ============================================================
# Получите в Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
CLIENT_SECRET=GOCSPX-your_client_secret

# ВАЖНО: Должен совпадать с URI в Google Cloud Console
# Development:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Production:
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_LOG_QUEUE=log_queue

# ============================================================
# JWT Settings
# ============================================================
JWT_EXPIRATION_DAYS=7